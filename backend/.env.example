# Copy to .env and edit. Every value below is also a safe default for local dev.

# --- Security -------------------------------------------------------------
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me-before-any-shared-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database -------------------------------------------------------------
# SQLite by default. Swap for Postgres without code changes, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/inspections
DATABASE_URL=sqlite:///./data/app.db

# --- Storage --------------------------------------------------------------
STORAGE_DIR=./storage
MAX_UPLOAD_MB=15

# --- Inference ------------------------------------------------------------
# auto | classifier | detector | mock
PREDICTOR_BACKEND=auto

# Inference device: auto | cpu | cuda | mps
# "auto" = CUDA if present, else CPU. It does not pick Apple's MPS on its own:
# requests are served from a thread pool and MPS is not reliably thread-safe.
# On a single-user Mac, INFERENCE_DEVICE=mps is noticeably faster.
INFERENCE_DEVICE=auto
CLASSIFIER_WEIGHTS=./models/car_damage_classifier.pth
DETECTOR_WEIGHTS=./models/yolov8_damage.pt

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Seed admin (created on first startup only) ---------------------------
FIRST_ADMIN_EMAIL=admin@drivetime.lk
FIRST_ADMIN_PASSWORD=ChangeMe123!
